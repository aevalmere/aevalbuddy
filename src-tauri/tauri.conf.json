{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aevaleron",
  "mainBinaryName": "Aevaleron",
  "version": "../package.json",
  "identifier": "com.aevaleron.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: http://aeval-frame.localhost aeval-frame:; connect-src ipc: http://ipc.localhost http://aeval-frame.localhost aeval-frame:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../build/desktop-*.dll": "desktop/"
    },
    "publisher": "darkelights",
    "shortDescription": "Screen-aware AI overlay for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "template": "./installer.nsi"
      }
    }
  }
}
