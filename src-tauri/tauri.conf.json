{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AevalBuddy",
  "mainBinaryName": "AevalBuddy",
  "version": "../package.json",
  "identifier": "com.aevalbuddy.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "darkelights",
    "shortDescription": "Screen-aware AI overlay for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
