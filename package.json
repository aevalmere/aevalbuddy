{
  "name": "aevalbuddy",
  "version": "1.1.0",
  "description": "Screen-aware AI overlay for Windows. Hidden from screen share, answers questions about whatever is on screen.",
  "main": "main.js",
  "private": true,
  "author": "darkelights",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "shots": "node tools/shots-run.js",
    "prebuild": "node tools/make-icon.js",
    "build": "electron-builder --win"
  },
  "electronmon": {
    "patterns": [
      "!dist/**",
      "!*.md",
      "!forge.zip"
    ]
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
